# Copy to .env and adjust. No real secrets are checked into git.

# App
APP_NAME=text-to-sql-platform
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Platform database (docker-compose service name "postgres" when run in Docker)
DATABASE_URL=postgresql+psycopg://platform:platform@postgres:5432/platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Auth - generate real values before any non-local use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-jwt-secret-please-rotate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Fernet key for encrypting stored DB credentials:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=3sJf3pQd2Kk8m3v3wq5nD8oX2b6rP0y1c4h7l9a2f0E=

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_CONCURRENCY=1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=documents

# Vector store
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=document_chunks

# LLM (Ollama) - dev profile default; use qwen3:8b for the full profile
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Embeddings / reranking
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base

# Text-to-SQL limits
SQL_MAX_ROWS=500
SQL_MAX_EXECUTION_SECONDS=15
SQL_MAX_RESULT_BYTES=2097152
SQL_MAX_COLUMNS=50
SQL_MAX_JOINS=6

# Document processing
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
ALLOW_SAMPLE_VALUES=false
SAMPLE_VALUES_LIMIT=3

# Seeding (set true only for local demo databases)
SEED_ON_STARTUP=false

# Observability
OTEL_ENABLED=false
